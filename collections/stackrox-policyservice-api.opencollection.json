            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{central-host}/v1/policies/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "GetPolicy returns the requested policy by ID."
        },
        {
          "info": {
            "name": "PutPolicy modifies an existing policy.",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{central-host}/v1/policies/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "PutPolicy modifies an existing policy."
