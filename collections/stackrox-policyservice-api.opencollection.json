          "info": {
            "name": "DeletePolicy removes a policy by ID.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{central-host}/v1/policies/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "DeletePolicy removes a policy by ID."
        },
        {
          "info": {
            "name": "EnableDisablePolicyNotification enables or disables notifications for a policy by ID.",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{central-host}/v1/policies/:policyId/notifiers",
            "params": [
              {
                "name": "policyId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "EnableDisablePolicyNotification enables or disables notifications for a policy by ID."
        },
        {
          "info": {
            "name": "GetPolicyCategories returns the policy categories.",
