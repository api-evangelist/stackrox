            "params": [
              {
                "name": "query",
                "value": "",
                "type": "query"
              },
              {
                "name": "pagination.limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "pagination.offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "pagination.sort_option.field",
                "value": "",
                "type": "query"
              },
              {
                "name": "pagination.sort_option.reversed",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "ListPolicies returns the list of policies."
        },
        {
          "info": {
            "name": "PostPolicy creates a new policy.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{central-host}/v1/policies",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "PostPolicy creates a new policy."
        },
        {
          "info": {
            "name": "DryRunPolicy evaluates the given policy and returns any alerts without creating the policy.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{central-host}/v1/policies/dryrun",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "DryRunPolicy evaluates the given policy and returns any alerts without creating the policy."
        },
        {
          "info": {
            "name": "ReassessPolicies reevaluates all the policies.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{central-host}/v1/policies/reassess"
