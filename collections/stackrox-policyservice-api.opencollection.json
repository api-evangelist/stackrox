        },
        {
          "info": {
            "name": "DeletePolicyCategory removes the given policy category.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{central-host}/v1/policyCategories/:category",
            "params": [
              {
                "name": "category",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "DeletePolicyCategory removes the given policy category."
        },
        {
          "info": {
            "name": "RenamePolicyCategory renames the given policy category.",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{central-host}/v1/policyCategories/:oldCategory",
            "params": [
              {
                "name": "oldCategory",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
