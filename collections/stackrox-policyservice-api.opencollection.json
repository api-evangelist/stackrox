        {
          "info": {
            "name": "PatchPolicy edits an existing policy.",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{central-host}/v1/policies/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
