{
  "opencollection": "1.0.0",
  "info": {
    "name": "API Reference AlertService UserService API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "UserService",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GetUsers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{central-host}/v1/users"
          }
        },
        {
          "info": {
            "name": "GetUser",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{central-host}/v1/users/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "GetUsersAttributes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{central-host}/v1/usersattributes"
          }
        }
      ]
    }
  ],
  "bundled": true
}