{
  "opencollection": "1.0.0",
  "info": {
    "name": "API Reference AlertService LicenseService API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "LicenseService",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "AddLicense",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{central-host}/v1/licenses/add",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "GetActiveLicenseExpiration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{central-host}/v1/licenses/expiration"
          }
        },
        {
          "info": {
            "name": "GetLicenses",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{central-host}/v1/licenses/list",
            "params": [
              {
                "name": "active",
                "value": "",
                "type": "query"
              },
              {
                "name": "statuses",
                "value": "",
                "type": "query"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}